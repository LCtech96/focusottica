# Copia questo file in `.env.local` e compila i valori.
# `.env.local` è ignorato da git: non finisce mai nel repository.

# --- Area riservata (/admin) -------------------------------------------------
# Senza questi valori il pannello usa le credenziali di default scritte nel
# codice, che sono pubbliche. In produzione vanno impostate entrambe.
ADMIN_EMAIL=shop@otticafocus.com
ADMIN_PASSWORD=scegli-una-password-lunga

# Chiave con cui viene firmato il cookie di sessione.
# Generala con:  openssl rand -base64 32
AUTH_SECRET=

# --- Archiviazione foto ------------------------------------------------------
# Obbligatorio su Vercel: senza, le foto caricate dal pannello vanno perse a
# ogni deploy. Si ottiene collegando uno store Vercel Blob al progetto
# (Dashboard → Storage → Create Database → Blob).
BLOB_READ_WRITE_TOKEN=
